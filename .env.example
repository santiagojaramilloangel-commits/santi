# ─── Image generation provider ───────────────────────────────────────────────
# One of: fal | replicate | gemini | demo
# If unset (or "demo") OR the matching key is missing, the app runs in honest
# demo mode (grayscale watermark placeholders — never faked as real AI).
IMAGE_PROVIDER=demo

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=
# Optional model override (default: fal-ai/image-apps-v2/hair-change)
# FAL_MODEL=fal-ai/image-apps-v2/hair-change

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Optional model override (default: black-forest-labs/flux-kontext-pro)
# REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# Google Gemini image editing
GEMINI_API_KEY=
# Optional model / base URL (Netlify AI Gateway sets GOOGLE_GEMINI_BASE_URL)
# GEMINI_MODEL=gemini-2.5-flash-image
# GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ─── Branding (public — safe for the browser) ────────────────────────────────
NEXT_PUBLIC_SHOP_NAME=Atelier Fade
NEXT_PUBLIC_LOGO_PATH=/logo.svg
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_PRICE_PER_CUT=45

# Digits only or +E.164 (used for wa.me links). Leave empty to use generic wa.me.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# If set, "Book this cut" opens this URL with ?service=<cut name>.
# If empty, booking falls back to WhatsApp when a number is configured.
NEXT_PUBLIC_BOOKING_URL=
